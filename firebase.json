{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.md",
      "**/*.rules",
      "**/*.rule",
      "**/*.backup",
      "**/*.zip",
      "**/package*.json",
      "**/PROJECT_REPORT*",
      "**/UI design*",
      "**/firebase-debug.log",
      "**/firestore-debug.log",
      "**/tests/**"
    ]
  },
  "firestore": {
    "rules": "firebase.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ]
}
